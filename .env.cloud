# .env.cloud — Trunk CLI environment for Conductor cloud workspaces
#
# The committed template for every trunk env var a cloud workspace needs.
# Canonical research (what each var does, verification status, traps):
#   findings/20261005-141227Z-trunk-cli-env-var-setup-mechanics.md
#
# Usage: fill in every <placeholder> below, then `set -a; source .env.cloud; set +a`.
# Never commit real keys — a filled copy lives outside the repo or in
# Conductor's [environment_variables.cloud], never in git.
#
# Deliberately trunk-only: FLOXHUB_*/INFISICAL_* are excluded on purpose —
# see the "DELIBERATELY ABSENT" section at the bottom for the full rationale
# and where those vars belong instead.

# ============================================================================
# STATIC — safe defaults, work as-is; nothing to fill in
# ============================================================================

# Silence the trunk launcher's bootstrap/download chatter in agent shells.
# Sandboxes that already export CI=true get this behavior automatically.
TRUNK_LAUNCHER_QUIET=1

# Opt out of Trunk usage telemetry.
TRUNK_TELEMETRY=off

# --- Optional static overrides (uncomment deliberately, no fill-in needed) ---

# Pin the trunk CLI version without — or OVER — a repo's .trunk/trunk.yaml pin.
# CAUTION: this overrides repo-pinned cli.version (this repo pins 1.25.0), so
# only export it as a deliberate floor for repos without their own trunk.yaml.
#TRUNK_CLI_VERSION=1.25.0

# Point the trunk cache (CLI binaries, linters, plugin repos) at a persistent
# volume instead of the default ~/.cache/trunk. Warm it once with
# `trunk check download` so cold starts don't re-download every linter.
#TRUNK_CACHE=/mnt/state/trunk-cache

# Proxy/CA knobs the trunk CLI honors for its own downloads. Only needed if a
# sandbox's proxy CA isn't already trusted system-wide (Conductor cloud
# sandboxes trust theirs, so these normally stay unset).
#HTTPS_PROXY=
#NO_PROXY=
#SSL_CERT_FILE=

# ============================================================================
# PLACEHOLDERS — replace each <...> with the real value BEFORE use
# ============================================================================

# --- trunk check --upload (upload results to the Trunk web app) ---
# 40-hex API token from the Trunk app. NOT needed for plain `trunk check`,
# which runs fully unauthenticated.
TRUNK_TOKEN=<trunk-check-upload-token>

# --- trunk flakytests uploads (trunk-analytics-cli) ---
# These three are required TOGETHER for any flaky-tests upload.
TRUNK_API_TOKEN=<trunk-org-api-token>
TRUNK_ORG_URL_SLUG=<org-url-slug>
TRUNK_TEST_COLLECTION_ID=<test-collection-id>

# ============================================================================
# DELIBERATELY ABSENT — FLOXHUB_* and INFISICAL_* (do not add them here)
# ============================================================================
#
# These are cloud-workspace env vars too, but they are excluded from this
# file ON PURPOSE. Sourcing this file must never authenticate a sandbox:
#
#   FLOXHUB_TOKEN        A sourced FLOXHUB_TOKEN permanently authenticates
#                        the sandbox to FloxHub, which disqualifies it as a
#                        testbed for the repo's unauthenticated-access
#                        testing (issue #16, trap 4: a Stage 4 PASS means
#                        nothing on an already-authenticated machine — five
#                        committed runs carry exactly that false PASS).
#   FLOXHUB_AUTOLOGIN    Opt-in flag, only meaningful alongside
#                        FLOXHUB_TOKEN — and equally contaminating.
#   INFISICAL_TOKEN      Machine credential for the setup script's Infisical
#                        secret reads (validated when present, optional
#                        otherwise).
#   INFISICAL_PROJECT_ID The Infisical project those secrets live in.
#
# Instead, all four flow per-workspace through ~/.conductor/settings.toml
# ([environment_variables.cloud]), so each sandbox receives only the subset
# its task actually needs (e.g. a publish task) and every fresh sandbox
# stays genuinely unauthenticated unless a task explicitly asks for auth.
# Nothing about them is a Trunk concern; they just share the cloud-workspace
# env layer this file templates.
